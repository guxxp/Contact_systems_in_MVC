@model ContatoModel

@{
    ViewData["Title"] = "Editar Contato";
}



<div class="content-card form-card">
    <div class="page-heading">
        <h1 class="h2">Editar contato</h1>
        <p>Atualize as informações deste contato.</p>
    </div>

<form asp-controller="Contato" asp-action="Alterar" method="post">
    <input  type="hidden" asp-for="Id"/>

    <div class="mb-3">
        <label for="nome" class="form-label"> Nome </label>
        <input type="text" asp-for="Nome" class="form-control" placeholder="Digite o Nome do Contato">
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="email" class="form-label"> Email </label>
        <input type="text" asp-for="Email" class="form-control" placeholder="Digite o E-mail do Contato">
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="celular" class="form-label"> Celular </label>
        <input type="text" asp-for="Telefone" class="form-control" placeholder="Digite o Celular do Contato">
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>
    <div class="d-flex gap-2 pt-2">
    <button type="submit" class="btn btn-primary">Alterar</button>

    <a class="btn btn-outline-secondary" asp-controller="Contato" asp-action="Index" role="button">Voltar</a>
    </div>
</form>