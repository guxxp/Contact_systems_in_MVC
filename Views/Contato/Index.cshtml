@model List<ContatoModel>

@{
	ViewData["Title"] = "Listagem de Contatos";
}



<div class="text-center">


	<div class="d-grip gap-2 d-md-flex justify-content-md-start">

		<a class="btn btn-primary" role="button" asp-controller="Contato" asp-action="CriarContato"> Adicionar novo Contato </a>

	</div>
	<br />


	@if(TempData["MensagemSucesso"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
			<span>
				@TempData["MensagemSucesso"]</span>
			<button type="button" class="btn-close close-alert" aria-label="Fechar alerta"></button>
		</div>
	}
	@if(TempData["MensagemErro"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
			<span>@TempData["MensagemErro"]</span>
			<button type="button" class="btn-close close-alert" aria-label="Fechar alerta"></button>
		</div>
	}

	<h1 class="display-5"> Listagem De Contatos </h1>

	<table class="table">
		<thead>
			<tr>
				<th scope="col">#</th>
				<th scope="col">Nome</th>
				<th scope="col">E-Mail</th>
				<th scope="col">Celular</th>
				<th scope="col"></th>
			</tr>
		</thead>
		<tbody>

			@if (Model != null && Model.Any())
			{
				foreach (ContatoModel contatoModel in Model)
				{
					<tr>
						<th scope="row">@contatoModel.Id</th>
						<td>@contatoModel.Nome</td>
						<td>@contatoModel.Email</td>
						<td>@contatoModel.Telefone</td>
						<td>
							<div class="btn-group" role="group">
								<a role="button" class="btn btn-primary" asp-route-id="@contatoModel.Id" asp-controller="Contato" asp-action="EditarContato">Editar</a>
								<a role="button" class="btn btn-secondary" asp-route-id="@contatoModel.Id" asp-controller="Contato" asp-action="ApagarConfirmacao">Apagar</a>
                    
							</div>
						</td>
					</tr>
				}

			}

       
		</tbody>
	</table>
</div>