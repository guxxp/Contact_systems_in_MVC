@model ContatoModel
@{
    ViewData["Title"] = "Apagar Contato";
}



<div class="content-card form-card text-center">
    <div class="hero-icon">!</div>
    <h1 class="h3 mb-3">Excluir contato?</h1>
    <p class="text-muted mb-4">Tem certeza de que deseja apagar <strong>@Model.Nome</strong>? Esta ação não poderá ser desfeita.</p>

<div class="d-flex justify-content-center gap-2">

    <a class="btn btn-danger" asp-controller="Contato" asp-action="Apagar" asp-route-id="@Model.Id" role="button">Apagar contato</a>

    <a class="btn btn-outline-secondary" asp-controller="Contato" asp-action="Index" role="button">Cancelar</a>
</div>
</div>
