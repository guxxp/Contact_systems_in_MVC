@model ContatoModel
@{
    ViewData["Title"] = "Apagar Contato";
}



<div class="text-center">


    <h3 class="display-5"> Realmente Deseja Apagar o Contato (@Model.Nome) </h3>

    
</div>

<br/>

<div class="d-grid gap-2">

    <a class="btn btn-primary" asp-controller="Contato" asp-action="Apagar" asp-route-id="@Model.Id" role="button">Apagar</a>

    <a class="btn btn-secondary" asp-controller="Contato" asp-action="Index" role="button">Voltar</a>
</div>
